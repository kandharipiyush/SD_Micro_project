# SocketScale Environment Configuration
JWT_SECRET=your-jwt-secret-key-at-least-32-chars
FAULT_ADMIN_TOKEN=your-admin-token-here

# AWS RDS PostgreSQL (or local fallback)
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@<AWS_RDS_ENDPOINT>:5432/socketscale
AWS_RDS_ENDPOINT=<your-rds-endpoint>.rds.amazonaws.com
AWS_RDS_PORT=5432
AWS_RDS_DB=socketscale
AWS_RDS_USER=postgres
